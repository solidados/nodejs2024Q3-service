PORT=4000

CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

LOG_LEVEL=2
LOG_SIZE=100000

POSTGRES_PORT=5432
POSTGRES_HOST=postgres-db
POSTGRES_DB=homelibrary
POSTGRES_USER=your_user_name
POSTGRES_PASSWORD=your_password

# Path for Development mode and local tests:
DATABASE_URL_LOCAL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Path for Docker run:
DATABASE_URL_DOCKER=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# By default, app uses value of POSTGRES_HOST:
DATABASE_URL=${DATABASE_URL_DOCKER}
